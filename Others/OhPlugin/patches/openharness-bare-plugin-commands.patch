+@pytest.mark.asyncio
+async def test_bare_plugin_command_registers_and_does_not_override_builtin(tmp_path: Path, monkeypatch):
+    monkeypatch.setenv("OPENHARNESS_CONFIG_DIR", str(tmp_path / "config"))
+    registry = create_default_command_registry(
+        plugin_commands=[
+            PluginCommandDefinition(
+                name="audit",
+                description="Audit dependencies",
+                content="Run dependency audit for $ARGUMENTS",
+            ),
+            PluginCommandDefinition(
+                name="help",
+                description="Would replace help",
+                content="Nope",
+            ),
+        ]
+    )
+    command, args = registry.lookup("/audit ./sample")
+    assert command is not None
+    assert command.name == "audit"
+    result = await command.handler(args, _make_context(tmp_path))
+    assert result.submit_prompt == "Run dependency audit for ./sample"
+
+    help_command, _ = registry.lookup("/help")
+    assert help_command is not None
+    assert help_command.name == "help"
+    assert "Available commands:" in (await help_command.handler("", _make_context(tmp_path))).message
+
+
