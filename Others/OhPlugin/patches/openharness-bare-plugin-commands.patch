+def test_plugin_command_can_opt_in_to_bare_openharness_name(tmp_path: Path, monkeypatch):
+    monkeypatch.setenv("OPENHARNESS_CONFIG_DIR", str(tmp_path / "config"))
+    project = tmp_path / "repo"
+    plugins_root = project / ".openharness" / "plugins"
+    plugins_root.mkdir(parents=True)
+    plugin_dir = plugins_root / "audit-plugin"
+    command_dir = plugin_dir / "commands"
+    command_dir.mkdir(parents=True)
+    (plugin_dir / "plugin.json").write_text(
+        json.dumps({"name": "audit-plugin", "version": "1.0.0"}), encoding="utf-8"
+    )
+    (command_dir / "audit.md").write_text(
+        "---\ndescription: Audit dependencies\nopenharness-command: audit\n---\nRun the audit.\n",
+        encoding="utf-8",
+    )
+
+    plugins = load_plugins(Settings(allow_project_plugins=True), project)
+
+    assert [command.name for command in plugins[0].commands] == ["audit"]
+
